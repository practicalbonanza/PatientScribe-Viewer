{
  "name": "patientscribe-viewer",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "browsers": "playwright install --with-deps chromium webkit",
    "typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p tsconfig.tooling.json",
    "check:sinks": "node scripts/check-sinks.mjs",
    "check:self": "node scripts/run-node-tests.mjs self",
    "test:fast": "node scripts/run-node-tests.mjs fast",
    "test:smoke": "node scripts/run-browser-tests.mjs",
    "vectors": "swift test/vectors/GenerateVectors.swift",
    "check": "npm run typecheck && npm run check:sinks && npm run check:self && npm run test:fast && npm run test:smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
